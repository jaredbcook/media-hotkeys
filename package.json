{
  "name": "media-hotkeys",
  "version": "0.1.0",
  "description": "A browser extension that adds hotkeys to control HTML video or audio on any webpage",
  "author": "Jared Cook",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:chrome": "tsx scripts/build.ts --browser chrome",
    "build:edge": "tsx scripts/build.ts --browser edge",
    "build:firefox": "tsx scripts/build.ts --browser firefox",
    "package": "tsx scripts/package.ts",
    "package:chrome": "tsx scripts/package.ts --browser chrome",
    "package:edge": "tsx scripts/package.ts --browser edge",
    "package:firefox": "tsx scripts/package.ts --browser firefox",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "safari:convert": "tsx scripts/safari-convert.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ scripts/ tests/ eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts",
    "format": "prettier --write src/ scripts/ tests/ docs/ .github/ eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts *.json *.md",
    "format:check": "prettier --check src/ scripts/ tests/ docs/ .github/ eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts *.json *.md",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/coverage-v8": "^5.0.5",
    "archiver": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "tldts": "^7.4.19",
    "webextension-polyfill": "^0.12.0"
  },
  "bugs": {
    "url": "https://github.com/jaredbcook/media-hotkeys/issues"
  },
  "homepage": "https://github.com/jaredbcook/media-hotkeys"
}
